# Private Google Sheet used by `npm run sync:regression`.
REGRESSION_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Read-only Notion Internal Connection used by `npm run sync:notion`.
# Never expose this token in NEXT_PUBLIC_* variables or frontend code.
NOTION_TOKEN=
NOTION_DOCS_DATA_SOURCE_ID=

# Public Firebase Web App configuration. These identify the Firebase app and are
# expected to appear in the browser bundle; never place a Gemini Developer API
# key in this file or in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public reCAPTCHA Enterprise site key registered for Firebase App Check.
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=

# Optional non-secret model override. Keep a stable Firebase AI Logic model.
NEXT_PUBLIC_FIREBASE_AI_MODEL=gemini-3.5-flash-lite
